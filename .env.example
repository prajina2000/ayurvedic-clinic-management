PORT=4000
DATABASE_URL=postgresql://postgres:your-postgres-password@127.0.0.1:5432/ayurvedic_clinic
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=12h
FRONTEND_URL=http://localhost:5173
CLINIC_NAME=Kariyil Krishna Clinic of Ayurveda
CLINIC_ADDRESS=Kerala, India
CLINIC_PHONE=
APP_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata

# Optional Meta WhatsApp Business Cloud API settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_DEFAULT_DEPARTMENT_ID=

# Bootstrap the first Admin with: npm run seed (from backend/)
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-unique-12-character-password
